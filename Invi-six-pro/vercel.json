{
  "version": 2,
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "{.env*,node_modules/**,.vercel/**,.git/**,.agents/**,.codex/**,.aws/**,tests/**,docs/**,scripts/**,**/*.log,**/*.pem,**/*.key,**/*.p12,**/*.pfx,README.md,vercel.json,.vercelignore,.gitignore}"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
